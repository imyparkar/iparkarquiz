{
  // Cloudflare Workers configuration for the iParkar Live HSE Quiz
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "QUIZ_ROOM", "class_name": "QuizRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "iparkar-quizzes", "database_id": "3ce93897-0d79-4e4e-a0f6-df6f05f9db7c", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
